#!/bin/bash
set -e

# Setup script for installing the environment with uv

PACKAGE_PATH="${PROJECT_ROOT}/scripts/package"

echo "Setting up Python environment with uv..."

# Create virtual environment at project root if it doesn't exist
if [ ! -d "${PROJECT_ROOT}/.venv" ]; then
    echo "Creating virtual environment at ${PROJECT_ROOT}/.venv..."
    cd "${PROJECT_ROOT}"
    uv venv
fi

# Install the package and all its dependencies from pyproject.toml
echo "Installing forge package and dependencies from pyproject.toml..."
cd "$PACKAGE_PATH"
uv pip install -e .

echo "Environment setup complete!"