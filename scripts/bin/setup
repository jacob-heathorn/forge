#!/bin/bash

# Install python requirements
python3 -m venv $FORGE_ROOT/.venv
source $FORGE_ROOT/.venv/bin/activate
python3 -m pip install --upgrade pip
python3 -m pip install -r $FORGE_ROOT/scripts/python/requirements.txt -q

# Delegate to the python setup tool
$PROJECT_ROOT/scripts/python/setup.py "$@"
