{{ format_comment(register.description, width=100, indent_width=0) }}
//
union {{ register.name }} {
  {# Generate all enumerations before the struct definition -#}
  {%- for field in register.fields | sort(attribute='bit_offset') if field.is_enumerated_type and field.enumerated_values %}
  {%- for enum_set in field.enumerated_values %}
  {%- set enum_name = enum_set.name if enum_set.name else field.name %}
  enum class e{{ enum_name }} : uint32_t {
    {%- for value in enum_set.enumerated_values %}
    e{{ value.name }} = {{ value.value }}, // {{ value.description.strip() }}
    {%- endfor %}
  };
  {% endfor %}
  {%- endfor %}
  {% set ns = namespace(last_bit=0, reserved_counter=0) %}  {#- Persist variables -#}
  {%- set ns.current_bit = 0 %}  {#- Track the current bit position -#}
  // Bit field definition.
  struct {
    {%- for field in register.fields | sort(attribute='bit_offset') %}  {#- Ensure sorted order -#}
    
    {#- Generate reserved bits to fill in the gaps. -#}
    {%- if field.bit_offset > ns.current_bit %}
    uint32_t _reserved_{{ ns.reserved_counter }} : {{ field.bit_offset - ns.current_bit }};
    {%- set ns.reserved_counter = ns.reserved_counter + 1 %}
    {%- endif %}

    {#- Generate doxygen comment -#}
    {%- set access_comment = field.access.value %}
    {%- set description_comment = field.description if field.description else '' %}
    {%- if access_comment or description_comment %}
    /// {{ access_comment }}{% if description_comment %} - {{ description_comment }}{% endif %}
    {%- endif -%}
    {#- Use enum only if there is exactly one enum definition for this field -#}
    {%- if field.is_enumerated_type and field.enumerated_values|length == 1 %}
    {%- set enum_name = field.enumerated_values[0].name if field.enumerated_values[0].name else field.name %}
    e{{ enum_name }} {{ field.name }} : {{ field.bit_width }};
    {%- else %}
    uint32_t {{ field.name }} : {{ field.bit_width }};
    {%- endif %}
    
    {#- Update current bit position -#}
    {%- set ns.current_bit = field.bit_offset + field.bit_width %}
    {%- endfor %}
    
    {#- Insert final reserved bits if there are gaps left -#}
    {%- if ns.current_bit < 32 %}
    uint32_t _reserved_{{ ns.reserved_counter }} : {{ 32 - ns.current_bit }};
    {%- endif %}
  } bits;
  
  // Full 32-bit register value.
  uint32_t value;

  {{ register.name }}() = delete;
  inline void Reset() volatile { this->value = 0x{{ "%08X" % register.reset_value }}; }
  static inline volatile {{ register.name }} &Instance() { return *reinterpret_cast<volatile {{ register.name }}*>(0x{{ "%08X" % (peripheral.base_address + register.address_offset) }}); }
};
