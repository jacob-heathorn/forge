{#- Emit one register: Fields sub-namespace + Register type alias.
    Context: r = the SVDRegister instance. -#}
{%- set reg_name = normalize_register_name(r.name) -%}
{%- set reg_bits = register_size(r) -%}
{%- set reg_addr = peripheral.base_address + r.address_offset -%}
{%- set reg_access = mmio_access(r.access) -%}
{%- set rows = build_field_rows(r) -%}
{{ format_comment(r.description, width=100, indent_width=0) }}
namespace {{ reg_name }}_Fields {
  {#- Emit enum classes for enumerated fields. -#}
  {%- for row in rows if row.kind == 'field' and row.field.is_enumerated_type and row.field.enumerated_values %}
  {%- for enum_set in row.field.enumerated_values %}
  {%- set enum_name = enum_set.name if enum_set.name else row.field.name %}

  enum class e{{ enum_name }} : std::uint32_t {
    {%- for value in enum_set.enumerated_values %}
    {%- if value.description %}
    // {{ value.description }}
    {%- endif %}
    e{{ value.name }} = {{ value.value }},
    {%- endfor %}
  };
  {%- endfor %}
  {%- endfor %}

  {#- Emit one Field alias per field row. -#}
  {%- for row in rows if row.kind == 'field' %}
  {%- if row.field.description %}
  // {{ row.field.description }}
  {%- endif %}
  using {{ row.name }} = ftl::mmio::Field<{{ row.width }}, {{ row.offset }}, {{ row.value_type }}, {{ row.access }}, {{ row.modify }}>;
  {%- endfor %}
}  // namespace {{ reg_name }}_Fields

using {{ reg_name }} = ftl::mmio::Register<
    0x{{ "%08X" % reg_addr }}u,
    0x{{ "%08X" % r.reset_value }}u,
    {{ reg_access }}
  {%- for row in rows -%}
  ,
    {%- if row.kind == 'field' %}
    {{ reg_name }}_Fields::{{ row.name }}
    {%- else %}
    ftl::mmio::Reserved<{{ row.width }}, {{ row.offset }}>
    {%- endif -%}
  {%- endfor %}>;
