{#- Emit one register: internal Field namespace + struct Register that re-exports fields.
    Call sites then read as: MCR::modify(MCR::MEN{MCR::eMEN::eENABLED}).
    Context provided by the wrapper template:
      item       = render-item dict from peripheral_render_items()
      r          = item.register (the underlying SVDRegister)
    Use item.name / item.addr_expr / item.is_templated rather than reading from
    r directly so cluster-array inner registers and plain registers go through
    the same path. -#}
{%- set reg_name = item.name -%}
{%- set reg_bits = register_size(r) -%}
{%- set reg_access = mmio_access(r.access) -%}
{%- set rows = build_field_rows(r) -%}
{{ format_comment(r.description, width=100, indent_width=0) }}
namespace {{ reg_name }}_fields_ {
  {#- Enum classes for enumerated fields. -#}
  {%- for row in rows if row.kind == 'field' and row.field.is_enumerated_type and row.field.enumerated_values %}
  {%- for enum_set in row.field.enumerated_values %}
  {%- set enum_name = enum_set.name if enum_set.name else row.field.name %}

  enum class e{{ enum_name }} : std::uint32_t {
    {%- for value in enum_set.enumerated_values %}
    {%- if value.description %}
    // {{ value.description }}
    {%- endif %}
    e{{ value.name }} = {{ value.value }},
    {%- endfor %}
  };
  {%- endfor %}
  {%- endfor %}

  {%- for row in rows if row.kind == 'field' %}
  {%- if row.field.description %}
  // {{ row.field.description }}
  {%- endif %}
  using {{ row.name }} = ftl::mmio::Field<{{ row.width }}, {{ row.offset }}, {{ row.value_type }}, {{ row.access }}, {{ row.modify }}>;
  {%- endfor %}
}  // namespace {{ reg_name }}_fields_

{% if item.is_templated -%}
template<{% for tp in item.template_params %}{% if not loop.first %}, {% endif %}std::uint32_t {{ tp.name }}{% endfor %}>
{% endif -%}
struct {{ reg_name }} : ftl::mmio::Register<
    {{ item.addr_expr }},
    {{ register_storage_type(r) }},
    {{ register_reset_literal(r) }},
    {{ reg_access }}
  {%- for row in rows -%}
  ,
    {%- if row.kind == 'field' %}
    {{ reg_name }}_fields_::{{ row.name }}
    {%- else %}
    ftl::mmio::Reserved<{{ row.width }}, {{ row.offset }}>
    {%- endif -%}
  {%- endfor %}> {
  {%- for tp in item.template_params %}
  static_assert({{ tp.name }} < {{ tp.dim }}u, "{{ reg_name }}: {{ tp.name }} out of range");
  {%- endfor %}
  {#- Re-export enums into the struct. -#}
  {%- for row in rows if row.kind == 'field' and row.field.is_enumerated_type and row.field.enumerated_values %}
  {%- for enum_set in row.field.enumerated_values %}
  {%- set enum_name = enum_set.name if enum_set.name else row.field.name %}
  using e{{ enum_name }} = {{ reg_name }}_fields_::e{{ enum_name }};
  {%- endfor %}
  {%- endfor %}
  {#- Re-export field types into the struct.
      When a field shares the register's name (common for single-field registers like GPIO::DR),
      expose it as `value_` to avoid the "nested type with same name as enclosing class" error. -#}
  {%- for row in rows if row.kind == 'field' %}
  {%- if row.name == reg_name %}
  using value_ = {{ reg_name }}_fields_::{{ row.name }};
  {%- else %}
  using {{ row.name }} = {{ reg_name }}_fields_::{{ row.name }};
  {%- endif %}
  {%- endfor %}
};
