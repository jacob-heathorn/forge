# Set the project root directory to the current directory
export PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd -P)"

# Set the forge tools root directory
export FORGE_ROOT=$PROJECT_ROOT

# Add the build tool directory to path, this allows us to "rip" script without prepending path.
export PATH=$PATH:$PROJECT_ROOT/scripts/bin

# Set paths to some external tools
export OPENOCD_DIR=$PROJECT_ROOT/../openocd/xpack-openocd-0.12.0-1-linux-x64/xpack-openocd-0.12.0-1/
export ARM_GCC_TOOLCHAIN_PATH=$PROJECT_ROOT/../gcc-arm-none-eabi/gcc-arm-none-eabi-10.3-2021.10-x86_64-linux/gcc-arm-none-eabi-10.3-2021.10/bin
export ARM_GDB_PATH=$PROJECT_ROOT/../gcc-arm-none-eabi/gcc-arm-none-eabi-10.3-2021.10-x86_64-linux/gcc-arm-none-eabi-10.3-2021.10/bin/arm-none-eabi-gdb
export NATIVE_GDB_PATH=/usr/bin/gdb

# Source the common environment script
source $FORGE_ROOT/scripts/common.envrc
