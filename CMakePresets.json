{
  "version": 7,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 23,
    "patch": 0
  },
  "include": [],
  "configurePresets": [
    {
      "name": "default",
      "hidden": true,
      "generator": "Ninja"
    },
    {
      "name": "native",
      "hidden": true,
      "inherits": "default",
      "toolchainFile": "${sourceDir}/cmake/native/toolchain.cmake",
      "cacheVariables": {
        "PLATFORM_PATH": "${sourceDir}/cmake/native",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "native-debug",
      "inherits": "native",
      "binaryDir": "${sourceDir}/.bin/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "native-release",
      "inherits": "native",
      "binaryDir": "${sourceDir}/.bin/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "native-tsan",
      "inherits": "native",
      "binaryDir": "${sourceDir}/.bin/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_C_FLAGS": "-fsanitize=thread -g -O1 -fno-omit-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fsanitize=thread -g -O1 -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=thread",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=thread"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "native-debug",
      "configurePreset": "native-debug"
    },
    {
      "name": "native-release",
      "configurePreset": "native-release"
    },
    {
      "name": "native-tsan",
      "configurePreset": "native-tsan"
    }
  ],
  "workflowPresets": [
    {
      "name": "native-debug",
      "steps": [
        {
          "type": "configure",
          "name": "native-debug"
        },
        {
          "type": "build",
          "name": "native-debug"
        }
      ]
    },
    {
      "name": "native-release",
      "steps": [
        {
          "type": "configure",
          "name": "native-release"
        },
        {
          "type": "build",
          "name": "native-release"
        }
      ]
    },
    {
      "name": "native-tsan",
      "steps": [
        {
          "type": "configure",
          "name": "native-tsan"
        },
        {
          "type": "build",
          "name": "native-tsan"
        }
      ]
    }
  ]
}
