module(
    name = "forge",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# Archives with no bazel support of their own; bazel/3p/ holds the BUILD files bazel installs in them.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "etl",
    build_file = "//bazel/3p:etl.BUILD",
    sha256 = "b47ca70e7394f50dd2d65dddfd088757525488ac2fd934f435705fbf3ffe6d3d",
    strip_prefix = "etl-20.40.0",
    urls = ["https://github.com/ETLCPP/etl/archive/refs/tags/20.40.0.tar.gz"],
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "forge_pip",
    python_version = "3.12",
    requirements_lock = "//scripts/package:requirements.txt",
)
use_repo(pip, "forge_pip")
