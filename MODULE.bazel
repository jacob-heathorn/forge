module(
    name = "forge",
    version = "0.1.0",
)

bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")

# Native C++ uses the auto-detected host toolchain (system gcc/g++ on
# Linux). Cross-compile toolchains (arm-none-eabi for mimxrt) will get
# registered here when downstream repos move to bazel.

# Python toolchain + pip deps for the SVD code generator.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
    is_default = True,
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "forge_pip",
    python_version = "3.12",
    requirements_lock = "//scripts/package:requirements.txt",
)
use_repo(pip, "forge_pip")

# ETL — resolved via gordion. The extension reads ETL_ROOT, or falls back
# to `gordion -f etl` if unset. There is no upstream-fetch fallback;
# gordion is the single source of truth for the ETL pin.
etl = use_extension("//bazel:etl.bzl", "etl")
use_repo(etl, "etl")
