load("//bazel:cc.bzl", "forge_cc_library")

# Vendored Pigweed unit-test framework. The forge `pw-ut-*` tests link this
# instead of GoogleTest.
forge_cc_library(
    name = "pw_unit_test",
    srcs = [
        "src/framework.cpp",
        "src/googletest_style_event_handler.cpp",
        "src/simple_printing_event_handler.cpp",
    ],
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# Default main() that wires up the simple printing event handler. Tests link
# this if they don't define their own main().
forge_cc_library(
    name = "pw_ut_main",
    srcs = ["//firmware/native:pw_ut_main.cpp"],
    visibility = ["//visibility:public"],
    deps = [":pw_unit_test"],
    alwayslink = True,
)
