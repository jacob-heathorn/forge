load("//bazel:cc.bzl", "forge_cc_binary", "forge_cc_test")

# Sanity check that GoogleTest itself works against ftl.
forge_cc_test(
    name = "gtest-ut-simple",
    srcs = ["ut_simple.cpp"],
    deps = [
        "//firmware/ftl",
        "@googletest//:gtest_main",
    ],
)

# Same source, run under the Pigweed test framework.
forge_cc_test(
    name = "pw-ut-simple",
    srcs = ["ut_simple.cpp"],
    deps = [
        "//firmware/ftl",
        "//firmware/pw_unit_test",
        "//firmware/pw_unit_test:pw_ut_main",
    ],
)

# Core ftl unit tests.
forge_cc_test(
    name = "ut-ftl",
    srcs = [
        "ut_byte_order.cpp",
        "ut_map.cpp",
        "ut_memory.cpp",
        "ut_mutex.cpp",
        "ut_singleton.cpp",
        "ut_thread.cpp",
    ],
    deps = [
        "//firmware/ftl",
        "//firmware/native:ftl-native",
        "@googletest//:gtest_main",
    ],
)

forge_cc_test(
    name = "ut-allocator",
    srcs = [
        "allocator/ut_buffer_allocator.cpp",
        "allocator/ut_bump_allocator.cpp",
        "allocator/ut_bump_pool_buffer_strategy.cpp",
        "allocator/ut_bump_pool_obj_strategy.cpp",
        "allocator/ut_fixed_pool_buffer_strategy.cpp",
        "allocator/ut_fixed_pool_obj_strategy.cpp",
        "allocator/ut_malloc_buffer_strategy.cpp",
        "allocator/ut_malloc_obj_strategy.cpp",
        "allocator/ut_obj_allocator.cpp",
    ],
    deps = [
        "//firmware/ftl",
        "//firmware/native:ftl-native",
        "@googletest//:gtest_main",
    ],
)

forge_cc_test(
    name = "ut-network",
    srcs = ["ut_udp_socket.cpp"],
    deps = [
        "//firmware/ftl",
        "//firmware/native:ftl-native",
        "@googletest//:gtest_main",
    ],
)

