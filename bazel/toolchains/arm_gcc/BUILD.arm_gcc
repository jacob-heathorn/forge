load("@forge//bazel/platforms:cores.bzl", "CORES")
load("@forge//bazel/toolchains/arm_gcc:config.bzl", "arm_gcc_toolchain_config")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(
        ["**"],
        exclude = ["share/**"],
    ),
)

[
    arm_gcc_toolchain_config(
        name = core + "_config",
        bin_dir = "bin",
        core = core,
        system_include_dirs = %{include_dirs},
    )
    for core in CORES
]

[
    cc_toolchain(
        name = core,
        all_files = ":all",
        ar_files = ":all",
        as_files = ":all",
        compiler_files = ":all",
        dwp_files = ":all",
        linker_files = ":all",
        objcopy_files = ":all",
        strip_files = ":all",
        supports_param_files = 0,
        toolchain_config = ":" + core + "_config",
    )
    for core in CORES
]
