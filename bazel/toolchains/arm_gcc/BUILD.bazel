load("@arm_gcc//:paths.bzl", "BIN_DIR", "SYSTEM_INCLUDE_DIRS")
load("@rules_cc//cc:defs.bzl", "cc_toolchain")
load("//bazel/platforms:cores.bzl", "CORES")
load(":config.bzl", "arm_gcc_toolchain_config")

package(default_visibility = ["//visibility:public"])

filegroup(name = "empty")

[
    arm_gcc_toolchain_config(
        name = core + "_config",
        bin_dir = BIN_DIR,
        core = core,
        system_include_dirs = SYSTEM_INCLUDE_DIRS,
        tags = ["manual"],
    )
    for core in CORES
]

[
    cc_toolchain(
        name = core,
        all_files = ":empty",
        compiler_files = ":empty",
        dwp_files = ":empty",
        linker_files = ":empty",
        objcopy_files = ":empty",
        strip_files = ":empty",
        supports_param_files = 0,
        tags = ["manual"],
        toolchain_config = ":" + core + "_config",
    )
    for core in CORES
]

[
    toolchain(
        name = core + "_toolchain",
        target_compatible_with = [
            "@platforms//cpu:armv7e-m",
            "@platforms//os:none",
            "//bazel/platforms:" + core + "_core",
        ],
        toolchain = ":" + core,
        toolchain_type = "@bazel_tools//tools/cpp:toolchain_type",
    )
    for core in CORES
]
